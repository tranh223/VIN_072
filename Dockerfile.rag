# ── Stage 1: base Python ────────────────────────────────────────────────────
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# ── Stage 2: dependencies ────────────────────────────────────────────────────
FROM base AS deps

COPY requirements.txt .
# Cài torch CPU trước để tránh pip kéo CUDA toolkit (~3GB) làm crash buildx trên runner
RUN pip install --upgrade pip \
    && pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt

# ── Stage 3: final image ─────────────────────────────────────────────────────
FROM deps AS final

COPY src/ ./src/

EXPOSE 8001

CMD ["uvicorn", "src.api.api_rag.app:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
