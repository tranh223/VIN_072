# Logging
LOG_LEVEL=INFO

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key
AI_LOG_DIR=.ai-log

# LLM (OpenAI)
DEFAULT_API_KEY=sk-...
DEFAULT_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL_ID=gpt-4o

# RAG — viết lại câu hỏi trước retrieval (kết hợp chat history trong session)
RAG_REWRITE_MODEL=gpt-5-nano
RAG_REWRITE_MAX_TOKENS=256
RAG_REWRITE_ENABLED=true

# VLM / OCR (OpenAI Vision)
OCR_API_KEY=sk-...
OCR_BASE_URL=https://api.openai.com/v1
OCR_MODEL_ID=gpt-4o

# MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=yourapp
MONGO_DB_NAME=your_db_name

# Google Cloud Storage
# Chạy trực tiếp trên máy (không Docker): đường dẫn tới file JSON, có thể dùng ./ten-file.json
GOOGLE_APPLICATION_CREDENTIALS=./your-gcp-service-account-key.json
# Docker Compose: đường dẫn TUYỆT ĐỐI trên host tới file JSON (VM thường dùng: /app/secrets/gcp-sa-key.json)
GCP_SA_KEY_HOST=/app/secrets/gcp-sa-key.json
GCS_BUCKET_NAME=your-gcs-bucket-name

# Rerank — Jina API (bắt buộc cho RAG; lấy key tại https://jina.ai)
JINA_API_KEY=jina_...
# JINA_RERANK_MODEL=jina-reranker-v3
# JINA_RERANK_URL=https://api.jina.ai/v1/rerank
# JINA_RERANK_TIMEOUT=60
# Nếu gặp Cloudflare 403/1010 (browser_signature_banned), ghi đè UA — mặc định đã tránh Python-urllib:
# JINA_HTTP_USER_AGENT=Mozilla/5.0 (compatible; TaxLawRAG/1.0; +https://jina.ai/)

# Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=...
# Để trống = Pinecone default namespace (_default_ trên console)
PINECONE_PUBLIC_NAMESPACE=
PINECONE_PRIVATE_NAMESPACE=user-data
MONGO_RAG_INDEX_VERSION=mongo-rag-v1

# Gmail / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASSWORD=...
FRONTEND_URL=http://localhost:3000

# Langsmith 
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="tax-scaify "

